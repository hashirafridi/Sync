<?xml version="1.0" encoding="utf-8"?>
<!-- Upward arrow rising out of a tray: publish from this device.
     Everything sits inside the middle 72x72 of the 108x108 canvas, so no launcher mask
     can clip it whatever shape the device crops to. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Arrow -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,28 L73,50 L63.5,50 L63.5,68 L44.5,68 L44.5,50 L35,50 Z" />

    <!-- Tray beneath it -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.92"
        android:pathData="M36,74 L72,74 A3,3 0 0 1 72,80 L36,80 A3,3 0 0 1 36,74 Z" />

</vector>
